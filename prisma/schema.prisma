generator client {
  provider      = "prisma-client-js"
  // debian-openssl-3.0.x is the engine for the node:22-bookworm-slim images; native keeps local dev working
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Neon: pooled for app traffic, direct for migrations (pooler breaks Prisma Migrate)
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  REVIEWER
  VIEWER
}

enum BrandStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerified   DateTime?
  name            String?
  image           String?
  passwordHash    String?
  /// Only ACTIVE accounts can sign in (ported from Cad account-eligibility)
  status          UserStatus @default(ACTIVE)
  deletedAt       DateTime?
  /// Bump to revoke every existing session (password change, disable)
  sessionVersion  Int        @default(0)
  /// May change platform-wide settings (Settings → AI models). Set directly in the database; no workspace role grants it.
  isPlatformAdmin Boolean    @default(false)
  /// Email me the weekly digest (opt-in; the in-app digest is for everyone). Off by the signed unsubscribe link too.
  digestEmail     Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  accounts        Account[]
  sessions        Session[]
  memberships     WorkspaceMember[]
  passwordResets  PasswordResetToken[]
  brandMembers    BrandMember[]
  ownedWorkspaces Workspace[]          @relation("WorkspacePrimaryOwner")
  pushDevices     PushDevice[]
  ownedContent    ContentItem[]        @relation("ContentOwner")
  ownedTasks      Task[]               @relation("TaskOwner")
  reviewingTasks  Task[]               @relation("TaskReviewer")
  createdTasks    Task[]               @relation("TaskCreatedBy")
  blockingTasks   Task[]               @relation("TaskBlockedOn")
  ownedProjects   WorkProject[]        @relation("WorkProjectOwner")
  notifications   Notification[]
  digests         Digest[]
}

/// A phone that gets push notifications (reel ready / couldn't be made). messages: the notification texts in the
/// phone's own language, sent by the app when it registers, so the server never needs a translation table.
model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Expo push token ("ExponentPushToken[...]"); a phone that signs in as someone else moves to them.
  token     String   @unique
  platform  String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  /// Primary owner (the creator): can't be demoted or removed; only they can hand it over
  ownerUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User? @relation("WorkspacePrimaryOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  members      WorkspaceMember[]
  brands       Brand[]
  roles        Role[]
  invitations  Invitation[]
  credits      CreditEntry[]
  voices       Voice[]
  subscription Subscription?
  digests      Digest[]
}

/// One reader's weekly digest for one workspace (server/digest/build.ts). Re-filtered by current permissions on read and
/// at email send; deleted when the member is removed; pruned after 12 weeks (pruneOldRows).
model Digest {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  /// Monday of the covered week (UTC label; each brand section carries its own range)
  weekStart   DateTime  @db.Date
  /// DigestBody (shared/digest.ts): per brand, the sections the reader could see at build time
  body        Json
  emailedAt   DateTime?
  createdAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, weekStart])
  @@index([workspaceId, weekStart])
  @@index([createdAt])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
}

/// The workspace's plan (mobile "06 No subscription"; server/services/subscriptions.ts). One per workspace.
model Subscription {
  id          String             @id @default(cuid())
  workspaceId String             @unique
  /// starter | professional (PLANS)
  planId      String
  status      SubscriptionStatus @default(ACTIVE)
  /// The current 30-day period; its credits were granted at periodStart
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, periodEnd])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  /// Legacy tier; superseded by roleId (fallback when roleId is null)
  role        WorkspaceRole @default(VIEWER)
  roleId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleRef   Role?     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([roleId])
  @@index([userId])
}

model Brand {
  id          String      @id @default(cuid())
  workspaceId String
  slug        String
  displayName String
  /// The name was guessed from the web address, not typed or picked by a person: Research may replace it with the
  /// name the site itself uses. Any rename by a person clears it.
  nameGuessed Boolean     @default(false)
  status      BrandStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile              BrandProfile?
  members              BrandMember[]
  agentRuns            AgentRun[]
  agentEvents          AgentEvent[]
  agentConfigs         BrandAgentConfig[]
  contextDocs          BrandContextDoc[]
  connections          IntegrationConnection[]
  auditReports         AuditReport[]
  chatThreads          ChatThread[]
  opportunities        Opportunity[]
  contentItems         ContentItem[]
  learningNotes        LearningNote[]
  competitors          Competitor[]
  invitations          Invitation[]
  photoShoots          PhotoShoot[]
  reelAssets           ReelAsset[]
  products             Product[]
  catalogPages         CatalogPage[]
  campaigns            Campaign[]
  tasks                Task[]
  workProjects         WorkProject[]
  taskComments         TaskComment[]
  notifications        Notification[]
  dataSources          DataSource[]
  postMetrics          PostMetric[]
  shopOrders           ShopOrder[]
  shopOrderLines       ShopOrderLine[]
  searchDays           SearchDay[]
  searchQueryDays      SearchQueryDay[]
  siteCrawls           SiteCrawl[]
  seoAlerts            SeoAlert[]
  adDays               AdDay[]
  adBudgets            AdBudget[]
  adAlerts             AdAlert[]
  shopifyWrites        ShopifyWrite[]
  blogArticles         BlogArticle[]
  quotes               Quote[]
  quoteVersions        QuoteVersion[]
  deals                Deal[]
  conversations        Conversation[]
  conversationMessages ConversationMessage[]
  companies            Company[]
  customers            Customer[]
  customerIdentities   CustomerIdentity[]
  customerNotes        CustomerNote[]

  // target for composite tenant FKs (AT-021): children reference (id, workspaceId)
  @@unique([id, workspaceId])
  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
}

model BrandProfile {
  id              String   @id @default(cuid())
  workspaceId     String
  brandId         String   @unique
  websiteUrl      String?
  /// What the owner said they mainly want to create (mobile onboarding A04): social-plan | marketing-videos | fashion-photoshoot | product-photoshoot
  goal            String?
  /// Typed by owners without a website (mobile onboarding A07); Research looks the business up from these
  about           String?
  location        String?
  /// Logo, colours, fonts and product photos read from the website by Research (server/research/brand-assets.ts)
  assets          Json?
  /// Tagline, tags, audience, strengths drafted by Research; fields people edited are kept (server/research/brand-summary.ts)
  summary         Json?
  /// Creative tones the owner picked (mobile A10); the content language lives in `locales`
  preferences     Json?
  /// The Google Maps listing the owner picked in onboarding (server/integrations/places.ts PlaceListing)
  place           Json?
  /// Photos the owner added to the brand's library (mobile Business M08): [{ key, title, addedAt }]; Research never touches it
  uploads         Json?
  /// The owner's automations (mobile Business M10): { monthlyPlan, autoPublish } (server/services/automations.ts)
  automations     Json?
  /// Last product catalogue sync: { at, source, count, error } (server/catalog/sync.ts)
  catalogSync     Json?
  /// IANA zone every campaign time is entered and shown in (server/content/offer-checks.ts zonedInstant/wallTime)
  timeZone        String?
  /// The Shopify blog articles go to (server/blog/shopify-articles.ts); null = the store's first blog
  shopifyBlogId   String?
  /// The next quote's number for this brand ("Q-0042"); taken and bumped in the quote's create transaction
  nextQuoteNumber Int      @default(1)
  /// The currency of the brand's quotes when it has no Shopify catalogue: the first quote's, required after that
  quoteCurrency   String?
  voiceSummary    String?
  pillars         Json?
  locales         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([brandId, workspaceId])
  @@index([workspaceId, brandId])
}

model BrandMember {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String
  userId      String
  /// Project role on this brand (adds to the workspace role)
  roleId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([brandId, userId])
  @@index([workspaceId, brandId])
  @@index([userId])
  /// Who holds a role on a brand: a role task's visibility and its TASK_ASSIGNED notices.
  @@index([brandId, roleId])
}

// --- Slice 0: duties, jobs, agents, audit, AI run log (foundation design §4–5, §8b) ---

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  DEAD_LETTER
}

/// Durable job queue (DEC-006/015). Claimed with FOR UPDATE SKIP LOCKED + lease.
model Job {
  id             String    @id @default(cuid())
  /// null for system jobs (e.g. account emails)
  workspaceId    String?
  brandId        String?
  type           String
  payload        Json
  status         JobStatus @default(PENDING)
  runAt          DateTime  @default(now())
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  leasedBy       String?
  leasedUntil    DateTime?
  lastError      String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt])
  @@index([status, leasedUntil])
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model AgentRun {
  id                String         @id @default(cuid())
  workspaceId       String
  brandId           String
  agentKey          String
  trigger           String
  status            AgentRunStatus @default(QUEUED)
  input             Json?
  output            Json?
  error             String?
  triggeredByUserId String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime       @default(now())

  brand  Brand        @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  events AgentEvent[]

  @@index([brandId, agentKey, createdAt])
  @@index([agentKey, status])
  @@index([triggeredByUserId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([createdAt])
}

enum AgentEventLevel {
  INFO
  SUCCESS
  WARN
  ERROR
}

/// Append-only Agent Log. Int id gives a monotonic cursor for polling.
// ponytail: Int id caps at ~2.1B events; switch to BigInt when the log gets there
model AgentEvent {
  id          Int             @id @default(autoincrement())
  workspaceId String
  brandId     String
  runId       String
  agentKey    String
  level       AgentEventLevel @default(INFO)
  message     String
  data        Json?
  entityType  String?
  entityId    String?
  createdAt   DateTime        @default(now())

  brand Brand    @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([brandId, id])
  @@index([runId, id])
  @@index([workspaceId, id])
}

model BrandAgentConfig {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String
  agentKey    String
  enabled     Boolean  @default(true)
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([brandId, agentKey])
}

/// Append-only audit trail (actor, timestamp, entity) for state transitions.
model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String?
  brandId     String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([workspaceId, brandId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([createdAt])
}

/// One row per AI provider call: model, prompt version, tokens, latency (DEC-003).
/// An AI model the app may call, with its list price. Platform-wide, edited on Settings → AI models by platform admins:
/// the code holds no model names. Read through server/ai/model-config.ts.
model AiModel {
  /// The provider's model id, as sent in API calls
  name             String   @id
  /// List prices in USD per 1M tokens, from the provider's pricing page
  inputUsdPerM     Decimal  @db.Decimal(10, 4)
  cachedUsdPerM    Decimal  @db.Decimal(10, 4)
  outputUsdPerM    Decimal  @db.Decimal(10, 4)
  /// Takes explicit prompt-cache breakpoints (OpenAI: GPT-5.6 and later)
  cacheBreakpoints Boolean  @default(true)
  /// Compared by the test set's `--models all`
  evalCandidate    Boolean  @default(false)
  /// Test-set judge: 1 = main judge, 2 = second side-by-side judge; null = not a judge
  judgeRank        Int?     @unique
  updatedAt        DateTime @updatedAt
  updatedBy        String?

  tiers   AiTier[] @relation("TierModel")
  backups AiTier[] @relation("TierBackup")
}

enum AiTierName {
  heavy
  medium
  light
}

/// The model each difficulty tier uses (server/ai/models.ts maps tasks to tiers) and the backup it tries once when
/// that model is unavailable. A model in use here can't be deleted.
model AiTier {
  tier      AiTierName @id
  model     String
  backup    String?
  updatedAt DateTime   @updatedAt
  updatedBy String?

  modelRef  AiModel  @relation("TierModel", fields: [model], references: [name], onUpdate: Cascade, onDelete: Restrict)
  backupRef AiModel? @relation("TierBackup", fields: [backup], references: [name], onUpdate: Cascade, onDelete: Restrict)
}

/// One row per AI call: the spend ledger (scripts/usage-report.ts). No foreign key to Brand on purpose: deleting a
/// brand or workspace must not erase what was spent.
model AiWorkflowRun {
  id                String   @id @default(cuid())
  workspaceId       String
  brandId           String
  agentRunId        String?
  /// Who caused it: the chat user, or whoever started the agent run; null = system (scheduled, evals)
  userId            String?
  workflowId        String
  promptVersion     String
  provider          String
  /// heavy | medium | light (server/ai/models.ts); null for rows from before routing
  tier              String?
  model             String
  status            String
  inputTokens       Int?
  /// Part of inputTokens billed at the cached rate
  cachedInputTokens Int?
  outputTokens      Int?
  /// Part of outputTokens spent thinking
  reasoningTokens   Int?
  webSearchCalls    Int?
  /// List price at the time of the call (tokens + web searches); null when the model's price isn't known
  costUsd           Decimal? @db.Decimal(12, 6)
  latencyMs         Int?
  error             String?
  /// Online eval (server/ai/graders.ts): true when the answer passed every check; null when there was no answer
  evalPassed        Boolean?
  /// What failed: [{ check, note, security? }]
  evalFindings      Json?
  createdAt         DateTime @default(now())

  @@index([brandId, createdAt])
  @@index([agentRunId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
  /// agentRunId in the middle: a person's chat turns (agentRunId IS NULL) without walking all their agent calls
  @@index([userId, agentRunId, createdAt])
}

/// One row per call to a paid outside API that isn't an AI model (Google Places, PageSpeed, Twilio Verify).
/// Same ledger rule: no foreign keys, rows outlive what they were for.
model ApiCall {
  id          String   @id @default(cuid())
  workspaceId String?
  brandId     String?
  userId      String?
  provider    String
  operation   String
  status      String
  latencyMs   Int?
  /// List price at the time of the call (free-tier allowances not subtracted)
  costUsd     Decimal? @db.Decimal(12, 6)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([provider, createdAt])
  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

/// One row per page opened, on the web app or the mobile app (admin console → Activity). Same ledger rule: no
/// foreign keys. Kept 180 days (the daily sweep). Only the path is stored: query strings and fragments are stripped.
model PageView {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  brandId     String?
  /// web | mobile
  platform    String
  path        String
  createdAt   DateTime @default(now())

  @@index([workspaceId, userId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// --- Slice 1: brand context documents (design §4.1, §8b-3) ---

enum ContextDocStatus {
  DRAFT
  CONFIRMED
  SUPERSEDED
}

/// Versioned strategy docs per brand (Okara's five docs). Agents read the latest CONFIRMED version.
model BrandContextDoc {
  id                String           @id @default(cuid())
  workspaceId       String
  brandId           String
  kind              String
  version           Int
  status            ContextDocStatus @default(DRAFT)
  markdown          String
  sources           Json             @default("[]")
  agentRunId        String?
  createdByUserId   String?
  confirmedByUserId String?
  confirmedAt       DateTime?
  createdAt         DateTime         @default(now())

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([brandId, kind, version])
  @@index([brandId, kind, status])
  @@index([brandId, agentRunId])
}

// --- Login hardening (ported from Cad auth) ---

enum RoleScope {
  WORKSPACE
  PROJECT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

/// Fixed-window rate-limit counters in Postgres (shared across instances, no Redis).
model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}

/// Short-lived shared values (clone challenges, in-flight markers, read caches); see server/db/transient.ts.
model TransientEntry {
  key       String   @id
  value     Json
  expiresAt DateTime

  @@index([expiresAt])
}

// --- RBAC + account flows (ported from Cad IAM, minus impersonation) ---

/// Workspace role = named set of permission keys from server/auth/permissions.catalog.ts.
/// ponytail: permissions as a text[] instead of Cad's RolePermission join table; add the
/// join table when per-permission scope/conditions are needed.
model Role {
  id          String    @id @default(cuid())
  workspaceId String
  slug        String
  name        String
  description String?
  isSystem    Boolean   @default(false)
  /// WORKSPACE roles go on workspace members; PROJECT roles on a brand (BrandMember)
  scope       RoleScope @default(WORKSPACE)
  permissions String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members      WorkspaceMember[]
  brandMembers BrandMember[]
  invitations  Invitation[]
  ownedTasks   Task[]            @relation("TaskOwnerRole")

  @@unique([workspaceId, slug])
}

/// Single-use invite; only the SHA-256 of the token is stored.
model Invitation {
  id              String    @id @default(cuid())
  workspaceId     String
  email           String
  roleId          String
  /// Set for a project invite: roleId is then a PROJECT role on this brand
  brandId         String?
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String?
  createdAt       DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  brand     Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  NOT_CONFIGURED
}

/// Outbox: emails are written in the same transaction as the action, sent by a job (Cad pattern).
model EmailOutbox {
  id        String      @id @default(cuid())
  to        String
  subject   String
  text      String
  html      String? // optional rich version; cleared after sending like text's links
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  error     String?
  sentAt    DateTime?
  /// What the email is about, for the send path: "digest:<digestId>" is rebuilt from that Digest at send time (after
  /// re-checking the reader) and scrubbed to "[digest]" after (scrubSent). Null for invites and resets.
  ref       String?
  createdAt DateTime    @default(now())

  @@index([status, createdAt])
}

enum IntegrationProvider {
  META // Facebook Pages
  INSTAGRAM
  THREADS
  GOOGLE // Analytics + Search Console
  GOOGLE_BUSINESS // Business Profile: one connection per location (reviews, local posts)
  REDDIT
  PINTEREST
  SHOPIFY // Admin API custom-app token, not OAuth: connected from its own form (server/catalog/shopify.ts)
  META_ADS // Meta ad accounts (ads_read only), its own login apart from META: one connection per ad account
}

enum ConnectionStatus {
  ACTIVE
  ERROR // token refresh/decrypt failed — needs reconnect
  REVOKED
}

/**
 * A brand's connected channel account. Tokens only ever live encrypted (DEC-002/018).
 */
model IntegrationConnection {
  id                   String              @id @default(cuid())
  workspaceId          String
  brandId              String
  provider             IntegrationProvider
  externalAccountId    String
  displayName          String
  scopes               String[]
  encryptedCredentials String? // null once revoked
  credentialKeyVersion Int
  tokenExpiresAt       DateTime?
  status               ConnectionStatus    @default(ACTIVE)
  lastError            String?
  connectedByUserId    String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([brandId, provider, externalAccountId])
  @@index([workspaceId, brandId])
  @@index([status, tokenExpiresAt])
}

/**
 * Single-use OAuth state (DEC-017): only the hash is stored; consumed atomically on callback.
 */
model OAuthStateTransaction {
  id           String              @id @default(cuid())
  stateHash    String              @unique
  workspaceId  String
  brandId      String
  userId       String
  provider     IntegrationProvider
  /// "mobile": the callback hands the code back to the app, which completes with its own token (never by state alone)
  client       String              @default("web")
  /// PKCE code_verifier for a connect that uses one (AskCart); sent once with the code, never to the browser
  codeVerifier String?
  /// The store a connect was started for (AskCart): the token answer must name the same one
  shop         String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime            @default(now())

  @@index([expiresAt])
}

enum AuditKind {
  SEO
  GEO
}

/**
 * One SEO or GEO audit produced by an agent run. Append-only; the UI shows the latest per kind.
 */
model AuditReport {
  id          String    @id @default(cuid())
  workspaceId String
  brandId     String
  kind        AuditKind
  score       Int // 0-100
  summary     String
  findings    Json // [{ id, category, severity, title, detail, url?, fix }]
  metrics     Json // kind-specific numbers (PageSpeed, crawler access, visibility…)
  agentRunId  String?
  createdAt   DateTime  @default(now())

  brand Brand  @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  tasks Task[]

  @@index([brandId, kind, createdAt])
  @@index([workspaceId, brandId])
}

/**
 * One CMO chat conversation for one person and one brand. Messages are AI SDK UIMessage[] (text + tool parts).
 */
model ChatThread {
  id          String   @id // client-generated by the chat UI
  workspaceId String
  brandId     String
  userId      String
  title       String
  messages    Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([brandId, userId, updatedAt])
  @@index([workspaceId, brandId])
}

enum OpportunityDecision {
  RECOMMEND
  HOLD
  REJECT
}

enum OpportunityStatus {
  NEW
  SHORTLISTED
  DISMISSED
  PLANNED // turned into calendar slots
}

/**
 * An idea worth posting about, found by the Opportunities agent. Deduped per brand.
 */
model Opportunity {
  id          String              @id @default(cuid())
  workspaceId String
  brandId     String
  dedupeKey   String
  title       String
  summary     String
  angle       String
  channels    String[]
  decision    OpportunityDecision
  reason      String
  score       Int // 0-100, for ordering
  timing      String? // e.g. "before 15 Nov", "evergreen"
  sources     Json                @default("[]") // [{ url, title }]
  status      OpportunityStatus   @default(NEW)
  agentRunId  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  brand Brand         @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  items ContentItem[]

  @@unique([brandId, dedupeKey])
  @@index([workspaceId, brandId, status, score])
}

enum ContentChannel {
  INSTAGRAM_POST
  INSTAGRAM_CAROUSEL
  INSTAGRAM_REEL
  INSTAGRAM_STORY
  FACEBOOK_POST
  PINTEREST_PIN
  THREADS_POST
  LINKEDIN_POST // planned and posted by hand: no publishing API (Phase 1)
  X_POST // planned and posted by hand: no publishing API (Phase 1)
}

/**
 * Content lifecycle (design §4.5). Agents move items up to AWAITING_APPROVAL; people do the rest.
 */
enum ContentStatus {
  PLANNED
  BRIEF_READY
  DRAFT_REVIEW
  AWAITING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  REVIEWED
  REJECTED
  BLOCKED
  CANCELLED
}

/**
 * One planned post for one channel and date. Brief + versions + quality checks hang off it.
 */
model ContentItem {
  id            String         @id @default(cuid())
  workspaceId   String
  brandId       String
  opportunityId String?
  title         String
  channel       ContentChannel
  status        ContentStatus  @default(PLANNED)
  scheduledFor  DateTime?
  pillar        String?
  brief         Json? // { goal, audience, keyMessage, products, cta, references, notes }
  // Catalogue Product ids the post features (Brief writer / app). ponytail: an id array, not a join table; a deleted
  // MANUAL product leaves a dangling id that the checks read as "no longer in the catalogue". Join table if posts
  // need querying by product at scale.
  productIds    String[]       @default([])
  // Campaign the post was planned for (Planner, createPost); never changed after. ponytail: not in the version body
  // because nothing changes it after planning; move it there like productIds when an "unlink" control comes.
  campaignId    String?
  studio        Boolean        @default(false) // made in the mobile Reels studio: the writing agents leave it alone
  postUrl       String? // posted by hand after a download; the link the person pasted back
  byHand        Boolean        @default(false) // a story the person posts themselves from a downloaded package
  // Who the post is for: whoever made it (or started the Planner run), else unassigned; the team can reassign it.
  ownerId       String?
  // A Pinterest Pin's planned board: set ahead of scheduling (the schedule step starts on it), both or neither. The name
  // is kept so cards don't call Pinterest; it is as the person's board list named it when they picked it and goes stale
  // if the board is renamed. Scheduling on another board moves the plan to that board.
  plannedBoardId   String?
  plannedBoardName String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  brand        Brand                @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  opportunity  Opportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  campaign     Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  owner        User?                @relation("ContentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  versions     ContentVersion[]
  decisions    ApprovalDecision[]
  publications PublicationAttempt[]
  renders      ReelRender[]
  recordings   ReelRecording[]
  tasks        Task[]

  @@index([workspaceId, brandId, status])
  @@index([brandId, scheduledFor])
  @@index([brandId, updatedAt])
  @@index([campaignId])
  // ponytail: Phase 0's indexes were added with a plain CREATE INDEX, which blocks writes to the table while it builds;
  // fine at today's size. Past ~1M rows, add such an index with CREATE INDEX CONCURRENTLY in a migration of its own.
  @@index([brandId, ownerId])
}

enum ReelRenderStep {
  VOICE // OpenAI voiceover per scene, photos cropped to 9:16
  CLIPS // one Higgsfield clip per scene, on the model its scene kind routes to
  JOIN // clips + voice → one MP4 in our storage
  DONE
  FAILED
}

/**
 * One paid attempt at turning a reel plan version into a video: voice (OpenAI) → clips (Higgsfield) → join (ffmpeg).
 */
model ReelRender {
  id               String         @id @default(cuid())
  workspaceId      String
  brandId          String
  contentItemId    String
  contentVersionId String // the plan version rendered
  attempt          Int // 1, 2, … per version: "Try again" is a new attempt with its own charge
  step             ReelRenderStep @default(VOICE)
  claimedAt        DateTime? // set while a step's submit is in flight; cleared once its request ids are saved
  requests         Json           @default("{}") // { CLIPS?: string[] } Higgsfield request ids, one per scene
  outputs          Json           @default("{}") // { voiceKeys, voiceSeconds, photoKeys, models, clipSeconds, backups, clipUrls }
  chargeId         String
  webhookSecret    String
  videoKey         String? // the finished MP4 in our media storage
  error            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  item ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([contentVersionId, attempt])
  @@index([contentItemId, createdAt])
}

/// A photoshoot (mobile "04 Photoshoot"): four shots of one brand photo, on the tier the person picked (server/photoshoot).
model PhotoShoot {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String
  /// product | fashion
  kind        String
  /// base | moderate | higher | ultra (tiers.ts)
  tier        String
  /// RUNNING | DONE | FAILED
  status      String   @default("RUNNING")
  /// What was asked: sourceKey, ratio and the setup choices
  input       Json
  /// Higgsfield request ids, one per shot (empty for OpenAI tiers, which answer at once)
  requests    String[]
  /// The finished shots in our media storage
  outputKeys  String[]
  credits     Int
  chargeId    String
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
}

/**
 * Immutable draft text. Approval (later slice) binds to one exact version.
 */
model ContentVersion {
  id            String   @id @default(cuid())
  contentItemId String
  version       Int
  body          Json // { hook, caption, hashtags[], slides[], script[], pinTitle, altText }
  createdBy     String // "agent" | user id
  agentRunId    String?
  /// The AI model that wrote this version (null for people's edits and drafts from before 2026-10-29)
  model         String?
  createdAt     DateTime @default(now())

  item   ContentItem    @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  checks QualityCheck[]

  @@unique([contentItemId, version])
}

enum QualityOverall {
  PASS
  WARN
  BLOCKER
}

model QualityCheck {
  id               String         @id @default(cuid())
  contentVersionId String
  overall          QualityOverall
  results          Json // [{ check, status: pass|warn|blocker, note }]
  agentRunId       String?
  createdAt        DateTime       @default(now())

  version ContentVersion @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)

  @@index([contentVersionId, createdAt])
}

/**
 * What the Analyst learned and what to test next. Append-only.
 */
model LearningNote {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String
  title       String
  body        String // markdown
  evidence    Json     @default("[]")
  agentRunId  String?
  createdAt   DateTime @default(now())

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, brandId, createdAt])
}

/**
 * A competitor this brand tracks. Private to the brand; its audits live in the shared SiteAudit library.
 */
model Competitor {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String
  name        String
  domain      String // normalized host, no www
  source      String // geo | document | search | manual
  createdAt   DateTime @default(now())

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([brandId, domain])
  @@index([workspaceId, brandId])
}

enum ProductSource {
  WEBSITE // the public /products.json feed of BrandProfile.websiteUrl
  SHOPIFY // Admin API through the brand's SHOPIFY connection
  MANUAL // added by a person
  IMPORT // from a spreadsheet a person uploaded: person-owned like MANUAL, re-imports update it
  SITE // read from the product data embedded in the website's product pages
}

/**
 * One sellable variant in the brand's catalogue. A sync writes only the fields it owns (sku through imageUrl,
 * archivedAt); materials, dimensions and certifications are always the person's (server/catalog/sync.ts).
 */
model Product {
  id             String        @id @default(cuid())
  workspaceId    String
  brandId        String
  source         ProductSource
  externalId     String? // variant id from the feed / Admin GID; null for MANUAL
  sku            String?
  title          String // "Product — Variant" when the variant has its own title
  url            String?
  category       String?
  description    String? // plain text (HTML stripped), ≤ 5,000 chars
  materials      String? // person-entered
  dimensions     String? // person-entered
  certifications String? // person-entered
  price          Decimal?      @db.Decimal(12, 2)
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  currency       String?
  inStock        Boolean? // null = unknown
  stockQuantity  Int? // Shopify Admin only
  stockCheckedAt DateTime? // when the source last told us about stock: "stock freshness"
  imageUrl       String?
  /// AskCart products only (null / empty from the other sources)
  vendor         String?
  tags           String[]      @default([])
  /// AskCart products only: [{ id, title, handle }]
  collections    Json?
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([brandId, source, externalId])
  @@index([workspaceId, brandId])
}

/// One product page the site reader knows about (from the sitemap): resumable state across days.
model CatalogPage {
  id          String    @id @default(cuid())
  workspaceId String
  brandId     String
  url         String
  lastmod     DateTime?
  readAt      DateTime?
  /// last attempt (read or failed): the daily budget counts these
  triedAt     DateTime?
  etag        String?
  modifiedAt  String?
  /// externalIds of the SITE rows this page produced
  productKeys String[]  @default([])
  /// ok | no-product | gone | failed
  state       String?

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([brandId, url])
  @@index([brandId, triedAt])
}

/**
 * A commercial push set by the commercial owner (brief B7): an offer (has `offer`, needs `endsAt`), a dated campaign
 * (`endsAt`, no `offer`) or a standing priority (no `endsAt`). Times are instants entered in the brand's timeZone;
 * the window is half-open (startsAt <= t < endsAt). Archived, never deleted (posts and audit keep reading it).
 * ponytail: one offer per campaign; two discounts in one sale are two campaigns.
 */
model Campaign {
  id              String    @id @default(cuid())
  workspaceId     String
  brandId         String
  name            String
  startsAt        DateTime
  endsAt          DateTime?
  productIds      String[]  @default([]) // catalogue link ids as posts store them; empty + no categories = whole catalogue
  categories      String[]  @default([]) // Product.category values, matched exactly
  offer           String? // what customers get and its conditions, as the team writes it
  discountPercent Int?
  code            String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  brand        Brand         @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  items        ContentItem[]
  workProjects WorkProject[]

  @@index([brandId, endsAt])
}

/**
 * Shared library of public-website audits, keyed by domain (not tenant-scoped on purpose).
 * Holds only data measured from public pages and web search. requestedByWorkspaceId is kept for
 * the audit trail and is never returned to other workspaces.
 */
model SiteAudit {
  id                     String   @id @default(cuid())
  domain                 String
  url                    String
  scores                 Json // { performance, accessibility, bestPractices, seo, siteChecks }
  findings               Json // top SEO findings [{ id, severity, title, fix }]
  aiCrawlers             Json // [{ ua, allowed }]
  approach               Json // { positioning, audience, products, priceSignals, contentThemes, strengths, weaknesses }
  socials                Json // [{ platform, url }]
  sources                Json     @default("[]")
  pagesRead              Int
  requestedByWorkspaceId String?
  agentRunId             String?
  createdAt              DateTime @default(now())

  @@index([domain, createdAt])
}

/**
 * Credit ledger: grants are positive, spends negative. Balance = sum of delta.
 */
model CreditEntry {
  id          String   @id @default(cuid())
  workspaceId String
  delta       Int
  reason      String // initial-grant | plan-credits | site-audit | reel-render | agent-run:<agent> | refund | top-up
  refId       String? // AgentRun id for spends/refunds
  userId      String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, reason, refId])
  @@index([workspaceId, createdAt])
}

enum ApprovalVerdict {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

/**
 * Append-only. An approval counts only while its version is still the latest and its hash matches.
 */
model ApprovalDecision {
  id               String          @id @default(cuid())
  workspaceId      String
  brandId          String
  contentItemId    String
  contentVersionId String
  packageHash      String // sha256 of the exact channel + version body approved
  verdict          ApprovalVerdict
  note             String?
  productOverride  Json? // { productIds, states }: availability issues approved anyway
  switchProducts   Boolean         @default(false) // CHANGES_REQUESTED: the Creator may pick another product
  byClient         Boolean         @default(false) // made as a client reviewer (decided then, not looked up later)
  userId           String
  createdAt        DateTime        @default(now())

  item ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId, createdAt])
  @@index([brandId, verdict, createdAt]) // plain CREATE INDEX: see the note on ContentItem's [brandId, ownerId]
}

enum PublicationStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED // the platform refused; safe to try again
  PENDING_VERIFY // outcome unknown (timeout, 5xx); a person checks before any retry
  PARTIAL // a story: some frames posted, the rest still to do
  CANCELLED
}

model PublicationAttempt {
  id               String              @id @default(cuid())
  workspaceId      String
  brandId          String
  contentItemId    String
  contentVersionId String
  packageHash      String
  connectionId     String
  provider         IntegrationProvider
  target           Json // { boardId?, imageUrl? }
  status           PublicationStatus   @default(SCHEDULED)
  runAt            DateTime
  externalId       String?
  externalUrl      String?
  error            String?
  createdByUserId  String
  publishedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  item    ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  metrics PostMetric[]

  @@index([contentItemId, createdAt])
  @@index([status, runAt])
  @@index([brandId, status, publishedAt])
}

/// Paid Higgsfield assets for reels (templates.ts): a brand's template preview, later its presenters.
/// A retry is a new row (new charge, new request). One RUNNING row per brand, kind and template (raw SQL index).
model ReelAsset {
  id              String   @id @default(cuid())
  workspaceId     String
  brandId         String
  /// template-preview | presenter
  kind            String
  /// RUNNING | DONE | FAILED
  status          String   @default("RUNNING")
  /// What was asked (template-preview: templateId, photoKey; then the cropped image and its signed link)
  input           Json
  requestId       String?
  /// The finished file in our media storage (a preview's poster is the same key with .jpg)
  outputKey       String?
  chargeId        String
  error           String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, kind, createdAt])
}

/// A voiceover the person recorded for one reel scene (mobile R11). The scene points at it (recordingId); its length
/// is the server's measure, written into the plan. Deleted with the reel; unused ones after 30 days (daily sweep).
model ReelRecording {
  id               String   @id @default(cuid())
  workspaceId      String
  contentItemId    String
  /// The 24 kHz mono WAV in the brand's media
  key              String
  seconds          Float
  /// What the person was asked to read, and what speech-to-text heard
  text             String
  transcript       String
  uploadedByUserId String
  createdAt        DateTime @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId])
  @@index([createdAt])
}

/// A workspace's cloned voice (ElevenLabs instant clone), usable in every brand of the workspace. At most 2 live.
/// The person's sample audio is never stored by us; ElevenLabs keeps it with the voice until the voice is deleted.
/// Archived = deleted, consent withdrawn or its owner removed; a job then deletes it at ElevenLabs.
model Voice {
  id              String    @id @default(cuid())
  workspaceId     String
  ownerUserId     String
  name            String
  /// ElevenLabs voice id; null while the clone is being made
  providerVoiceId String?
  /// A short sample made once with the voice (our media)
  sampleKey       String?
  /// Consent record: userId, time, consent text version, app version, SHA-256 of the audio sent, ElevenLabs sample id
  consent         Json
  createdAt       DateTime  @default(now())
  archivedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, archivedAt])
}

/// A photo or clip the person uploaded for a story frame (presigned PUT, then verified). Unused ones are swept after 7 days.
model MediaUpload {
  id                String    @id @default(cuid())
  workspaceId       String
  brandId           String
  key               String    @unique
  kind              String // "photo" | "video"
  status            String    @default("PENDING") // "PENDING" | "VERIFIED" | "REJECTED"
  bytes             Int
  durationSec       Float?
  width             Int?
  height            Int?
  hasAudio          Boolean?
  productId         String?
  rightsConfirmedBy String?
  rightsConfirmedAt DateTime?
  reason            String?
  createdBy         String
  createdAt         DateTime  @default(now())

  taskAttachments TaskAttachment[]

  @@unique([brandId, productId])
  @@index([workspaceId, brandId, status, createdAt])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskArea {
  CONTENT
  WEBSITE
  SEO
  GENERAL
  CRM
}

enum WebsiteChangeKind {
  PRODUCT_PAGE
  COLLECTION
  MENU
  HOMEPAGE
  LANDING_PAGE
  BUG
  CORRECTION
  OTHER
}

enum WorkProjectStatus {
  ACTIVE
  DONE
  ARCHIVED
}

enum TaskCommentKind {
  COMMENT
  APPROVED
  CHANGES_REQUESTED
  SYSTEM
}

/// AD_ALERT is added in its own migration (20261126140000): Postgres can't use a value added by ALTER TYPE … ADD VALUE
/// in the same transaction.
enum NotificationKind {
  TASK_ASSIGNED
  REVIEW_REQUESTED
  TASK_OVERDUE
  TASK_RECHECK
  TASK_APPROVED
  TASK_CHANGES_REQUESTED
  AD_ALERT
  /// added in its own migration (20261126150300): an enum value can't be used in the migration that adds it
  SEO_ALERT
}

enum TaskAttachmentRole {
  BEFORE
  AFTER
  OTHER
}

/// A piece of team work on one brand: content, website, SEO or general. Status moves only through the task actions.
/// The open-only partial indexes, the one-open-task-per-finding unique index, the Done-view index and the trigram
/// index on title are raw SQL in the phase1_tasks migration (Prisma can't express them).
model Task {
  id                 String             @id @default(cuid())
  workspaceId        String
  brandId            String
  title              String
  description        String?
  status             TaskStatus         @default(TODO)
  priority           TaskPriority       @default(NORMAL)
  areas              TaskArea[]         @default([GENERAL])
  ownerId            String?
  /// A project role owns the task until someone holding it takes it. At most one of ownerId and ownerRoleId is set
  /// (CHECK task_one_owner).
  ownerRoleId        String?
  /// Set when the task needs review; such a task reaches DONE only through approve.
  reviewerId         String?
  createdById        String?
  /// A day in the brand's time zone.
  dueOn              DateTime?          @db.Date
  /// Non-null = blocked (on any open status).
  blockedReason      String?
  /// Who can unblock it.
  blockedOnId        String?
  workProjectId      String?
  contentItemId      String?
  /// The affected page, http(s).
  url                String?
  changeKind         WebsiteChangeKind?
  acceptanceCriteria String?
  previewUrl         String?
  /// Cleared when url changes or the task reopens.
  checkedLiveAt      DateTime?
  checkedLiveById    String?
  auditReportId      String?
  /// The audit finding this task came from.
  findingKind        AuditKind?
  findingId          String?
  /// The finding's pages when the task was made (empty = site-wide).
  findingUrls        String[]           @default([])
  /// Set by the audit that no longer finds it.
  findingClearedAt   DateTime?
  /// SEO: look at performance again on this day.
  recheckOn          DateTime?          @db.Date
  /// Set on DONE, cleared on reopen.
  completedAt        DateTime?
  requestId          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  brand         Brand               @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  owner         User?               @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerRole     Role?               @relation("TaskOwnerRole", fields: [ownerRoleId], references: [id], onDelete: SetNull)
  reviewer      User?               @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdBy     User?               @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  blockedOn     User?               @relation("TaskBlockedOn", fields: [blockedOnId], references: [id], onDelete: SetNull)
  workProject   WorkProject?        @relation(fields: [workProjectId], references: [id], onDelete: SetNull)
  contentItem   ContentItem?        @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  auditReport   AuditReport?        @relation(fields: [auditReportId], references: [id], onDelete: SetNull)
  checklist     TaskChecklistItem[]
  attachments   TaskAttachment[]
  files         TaskFile[]
  comments      TaskComment[]
  notifications Notification[]
  blogArticles  BlogArticle[]

  @@unique([brandId, requestId])
  @@index([workProjectId, status])
  @@index([contentItemId])
  @@index([ownerId])
  @@index([reviewerId])
  @@index([blockedOnId])
  @@index([createdById])
  /// A finding's earlier tasks, newest first (tasksFromReport).
  @@index([brandId, findingKind, findingId, createdAt])
}

model TaskChecklistItem {
  id       String    @id @default(cuid())
  taskId   String
  text     String
  doneAt   DateTime?
  doneById String?
  position Int

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

/// A brand photo on a task. Restrict: removing the attachment or deleting the task never deletes the upload.
model TaskAttachment {
  id            String             @id @default(cuid())
  taskId        String
  mediaUploadId String
  role          TaskAttachmentRole
  createdById   String
  createdAt     DateTime           @default(now())

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mediaUpload MediaUpload @relation(fields: [mediaUploadId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([mediaUploadId])
}

/// A document on a task (PDF, Office, CSV, text, or a photo as a file), apart from MediaUpload so it never reaches the
/// story picker or the photo library. PENDING: a slot handed out; CHECKING: its bytes being checked; VERIFIED: stored at
/// `key` under the verified `contentType`. A refused file loses its row (server/tasks/files.ts).
model TaskFile {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String
  taskId      String
  key         String   @unique
  status      String   @default("PENDING") // "PENDING" | "CHECKING" | "VERIFIED"
  contentType String
  /// As the person named it (cleaned); shown as text only, never in a header (downloadName is).
  fileName    String
  bytes       Int
  createdById String
  createdAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, status])
  @@index([status, createdAt])
}

/// A group of tasks with dates (a launch, a site rebuild). Progress = done / (all - cancelled). The trigram index on
/// name is raw SQL in the phase1_tasks migration.
model WorkProject {
  id            String            @id @default(cuid())
  workspaceId   String
  brandId       String
  name          String
  description   String?
  ownerId       String?
  status        WorkProjectStatus @default(ACTIVE)
  startsOn      DateTime?         @db.Date
  dueOn         DateTime?         @db.Date
  campaignId    String?
  clientVisible Boolean           @default(false)
  requestId     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  brand      Brand                  @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  owner      User?                  @relation("WorkProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  campaign   Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  tasks      Task[]
  milestones WorkProjectMilestone[]

  @@unique([brandId, campaignId])
  @@unique([brandId, requestId])
  @@index([brandId, status, dueOn])
}

model WorkProjectMilestone {
  id            String    @id @default(cuid())
  workProjectId String
  title         String
  dueOn         DateTime  @db.Date
  doneAt        DateTime?
  position      Int

  workProject WorkProject @relation(fields: [workProjectId], references: [id], onDelete: Cascade)

  @@index([workProjectId, dueOn])
}

/// Append-only (no edit or delete). authorId is null for SYSTEM comments; internal ones are never shown to a client.
model TaskComment {
  id          String          @id @default(cuid())
  workspaceId String
  brandId     String
  taskId      String
  authorId    String?
  kind        TaskCommentKind
  body        String
  byClient    Boolean         @default(false)
  internal    Boolean         @default(false)
  createdAt   DateTime        @default(now())

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

/// One in-app notice for one person. dedupeKey: event kinds <kind>:<userId>:<auditEventId>; daily kinds
/// <kind>:<userId>:<taskId>:<brand-local yyyy-mm-dd>. Pruned after 90 days by the daily sweep.
model Notification {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String
  brandId     String
  kind        NotificationKind
  taskId      String?
  /// AD_ALERT notices: the alert they point at (no task)
  adAlertId   String?
  /// SEO_ALERT notices: the lead alert of the run that raised them (no task)
  seoAlertId  String?
  actorId     String?
  dedupeKey   String           @unique
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand    Brand     @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  adAlert  AdAlert?  @relation(fields: [adAlertId], references: [id], onDelete: Cascade)
  seoAlert SeoAlert? @relation(fields: [seoAlertId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, readAt, createdAt])
  @@index([createdAt])
  @@index([userId, workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([taskId])
  @@index([brandId, workspaceId])
  @@index([adAlertId])
  @@index([seoAlertId])
}

enum DataSourceKind {
  SEARCH_CONSOLE
  POST_METRICS
  SHOPIFY_ORDERS
  META_ADS
  /// quote status, expiry and payment reminders (server/quotes/status-sync.ts); no connection, externalId ""
  SHOPIFY_QUOTES
}

enum DataSourceStatus {
  ACTIVE
  ERROR
  OFF
}

/// One outside source of daily numbers for a brand (a Search Console site, an ad account, a shop's orders, its post
/// metrics), filled by `data.sync` jobs (server/data/sources.ts). Rows stay when the connection goes; purged with the brand.
model DataSource {
  id            String           @id @default(cuid())
  workspaceId   String
  brandId       String
  kind          DataSourceKind
  /// null for POST_METRICS (each post uses its own connection)
  connectionId  String?
  /// siteUrl | "act_123" | shop domain | "" for POST_METRICS
  externalId    String
  /// shop domain, ad account name: shown only to people who manage integrations
  label         String?
  /// { timeZone, currency } of an ad account; { reportsIn: "America/Los_Angeles" } for Google
  settings      Json?
  status        DataSourceStatus @default(ACTIVE)
  /// last provider day held contiguously; null = the daily window only
  syncedThrough DateTime?        @db.Date
  /// Shopify updated_at high-water mark
  cursor        String?
  /// DataSyncResult { at, okAt, reason, count, error } like BrandProfile.catalogSync; error is a fixed string
  lastResult    Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([brandId, kind, externalId])
  @@index([status])
}

/// A published post's numbers as read on one brand-local day (server/data/post-metric-sync.ts). Read on a decaying
/// schedule for 30 days; after that only the final row is kept. A null metric is one the platform didn't give.
model PostMetric {
  id                   String   @id @default(cuid())
  workspaceId          String
  brandId              String
  publicationAttemptId String
  /// brand-local day of the read
  day                  DateTime @db.Date
  readAt               DateTime
  reach                Int?
  views                Int?
  likes                Int?
  comments             Int?
  shares               Int?
  saves                Int?
  interactions         Int?
  /// Instagram stories only: taps forward, back, exits and next-story swipes, summed over the frames
  navigation           Int?

  attempt PublicationAttempt @relation(fields: [publicationAttemptId], references: [id], onDelete: Cascade)
  brand   Brand              @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([publicationAttemptId, day])
  @@index([brandId])
}

/// One Shopify order's totals (Sales tab), upserted on (brandId, shopifyId) so an edit or refund overwrites the row.
/// No customer data: the client's field list is an allow-list. Summed per brand-local day on read.
/// ponytail: no rollup table; past ~100k orders in a range, add a per-day rollup written by the sync.
model ShopOrder {
  id                 String    @id @default(cuid())
  workspaceId        String
  brandId            String
  connectionId       String
  /// gid://shopify/Order/…
  shopifyId          String
  /// "#1001"
  name               String
  processedAt        DateTime
  cancelledAt        DateTime?
  test               Boolean
  /// shopMoney currency
  currency           String
  /// currentSubtotalPriceSet (after discounts, refunds, edits); gross = netSales + discounts
  netSales           Decimal   @db.Decimal(14, 2)
  discounts          Decimal   @db.Decimal(14, 2)
  shipping           Decimal   @db.Decimal(14, 2)
  /// sum of currentTaxLines, not totalTaxSet; includes the shipping tax (checked live 2026-11-26)
  taxes              Decimal   @db.Decimal(14, 2)
  /// the tax on the shipping still charged (server/data/shopify-orders.ts shippingTaxesOf); null on rows read before
  /// 20261126110000 or when the shipping lines came unreadable
  shippingTaxes      Decimal?  @db.Decimal(14, 2)
  taxesIncluded      Boolean
  /// currentTotalPriceSet
  total              Decimal   @db.Decimal(14, 2)
  /// display only; already in netSales and total
  refunded           Decimal   @db.Decimal(14, 2)
  sourceName         String?
  /// displayFulfillmentStatus / displayFinancialStatus (Shopify enum strings); AskCart only, null when not sent
  fulfillmentStatus  String?
  financialStatus    String?
  /// AskCart only; codes, never who used them
  discountCodes      String[]  @default([])
  /// AskCart's own flag: the order has more line items than it sent (it sends the first 100), or it paused mid-order.
  /// Lines we couldn't read don't set it (the sync counts them as linesSkipped).
  lineItemsTruncated Boolean   @default(false)
  shopifyUpdatedAt   DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([brandId, shopifyId])
  @@index([brandId, processedAt])
}

/// One line item of a ShopOrder (AskCart only; the pasted-token path stores none). Upserted whenever its order's row
/// is written with line items; lines gone from the order are deleted only when the order was sent whole (not flagged
/// lineItemsTruncated, no line we couldn't read). An order read without line items keeps the lines stored. No customer data.
model ShopOrderLine {
  id              String   @id @default(cuid())
  workspaceId     String
  brandId         String
  /// the order's gid://shopify/Order/… (ShopOrder.shopifyId)
  orderShopifyId  String
  /// gid://shopify/LineItem/…
  lineShopifyId   String
  /// gid://shopify/Product/… / ProductVariant/…; null when deleted from the store
  productId       String?
  variantId       String?
  /// null when productId is null (custom staff-typed lines and deleted products: AskCart withholds the text)
  title           String?
  variantTitle    String?
  sku             String?
  quantity        Int
  /// after refunds and edits; null when not sent
  currentQuantity Int?
  unitPrice       Decimal  @db.Decimal(14, 2)
  /// discountedTotalSet: the line's total after discounts
  discountedTotal Decimal  @db.Decimal(14, 2)
  /// discountedUnitPriceAfterAllDiscountsSet: includes order-level discount allocations; net line sales ≈ currentQuantity × this. Null when not sent.
  netUnitPrice    Decimal? @db.Decimal(14, 2)
  currency        String
  createdAt       DateTime @default(now())

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([brandId, lineShopifyId])
  @@index([brandId, orderShopifyId])
}

enum SearchDimension {
  SITE
  PAGE
}

/// Search Console numbers per Google day (Pacific time), as Google reports them. SITE: the site's totals (page "");
/// PAGE: the day's top pages (server/data/search-console.ts PAGES_PER_DAY), so page sums sit below the site total.
/// Written by the SEARCH_CONSOLE sync (server/data/search-sync.ts): per complete day, delete then insert.
/// ponytail: ~500 rows/brand/day (~180k/brand/year), never pruned. Ceiling ~20M rows across brands; then roll PAGE rows
/// older than 16 months into monthly rows.
model SearchDay {
  id          String          @id @default(cuid())
  workspaceId String
  brandId     String
  siteUrl     String
  dimension   SearchDimension
  /// Google's day (Pacific time)
  day         DateTime        @db.Date
  /// "" for SITE; the page URL (at most MAX_PAGE_KEY chars) for PAGE
  page        String
  clicks      Int
  impressions Int
  /// position × impressions, so a range's average position is impression-weighted: positionSum / impressions
  positionSum Float

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  /// The migration adds INCLUDE (clicks, impressions, positionSum) so reads are index-only; migrate diff shows it as a
  /// re-create, don't let a generated migration drop it. No other index: any would be a prefix of this one.
  @@unique([brandId, siteUrl, dimension, day, page])
}

enum SearchQueryDimension {
  QUERY
  QUERY_PAGE
}

/// Search Console queries per Google day: QUERY (page "") and QUERY_PAGE, top QUERIES_PER_DAY each, as Google
/// reports them. Google leaves anonymised queries out, so sums sit below SearchDay's SITE total.
/// Written with SearchDay by the SEARCH_CONSOLE sync (server/data/search-sync.ts), only for days whose query calls
/// succeeded; rows older than QUERY_RETENTION_DAYS (400) deleted by housekeeping (server/jobs/runner.ts).
/// ponytail: ~1,000 rows/brand/day, ~400k per brand at steady state. Ceiling ~20M rows (~50 brands); then roll rows
/// older than 90 days into weekly rows.
model SearchQueryDay {
  id          String               @id @default(cuid())
  workspaceId String
  brandId     String
  siteUrl     String
  dimension   SearchQueryDimension
  /// Google's day (Pacific time)
  day         DateTime             @db.Date
  /// at most MAX_QUERY_KEY chars; siteUrl + query + page at most MAX_QUERY_ROW_KEY_BYTES (btree tuple limit)
  query       String
  /// "" for QUERY
  page        String
  clicks      Int
  impressions Int
  /// position × impressions, as SearchDay
  positionSum Float

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  /// The migration adds INCLUDE (clicks, impressions, positionSum), as SearchDay's: don't let a generated migration
  /// drop it.
  @@unique([brandId, siteUrl, dimension, day, query, page])
  /// housekeeping's delete
  @@index([day])
}

enum SiteCrawlStatus {
  RUNNING
  COMPLETE
  /// robots.txt unreadable or disallows us, or a bot wall: nothing reported
  STOPPED
  /// ran out of days (CYCLE_MAX_DAYS): its findings are reported, nothing is cleared
  PARTIAL
  /// websiteUrl changed: never reported
  ABANDONED
}

enum SiteCrawlUrlKind {
  /// read in full for its links (from the sitemap, or link-following when there is none)
  PAGE
  /// a same-site link target that isn't a PAGE: 1-byte GET
  TARGET
}

/// One weekly full-site link check (server/seo/site-crawl.ts). Resumes from its rows; the job payload names it (and
/// its run number) only. Kept: the brand's latest COMPLETE/PARTIAL cycle and the RUNNING one; older ones deleted when
/// a cycle starts.
model SiteCrawl {
  id                String          @id @default(cuid())
  workspaceId       String
  brandId           String
  /// websiteUrl's origin when the cycle started; a run that finds another site stops the cycle
  origin            String
  status            SiteCrawlStatus @default(RUNNING)
  startedOn         DateTime        @db.Date
  discoveryComplete Boolean         @default(false)
  /// true when no sitemap was found and pages come from following links from the home page
  followLinks       Boolean         @default(false)
  /// next run not before (Retry-After, or tomorrow after a budget stop)
  pausedUntil       DateTime?
  /// runs queued so far: the next job's key (seo-links:<crawlId>:<runNo>) and its payload's runNo
  runNo             Int             @default(0)
  stopReason        String?
  pages             Int             @default(0)
  targets           Int             @default(0)
  checked           Int             @default(0)
  /// links seen past TARGETS_MAX (or LINK_FOLLOW_MAX) and not stored: reported as unchecked (a link on two pages counts twice)
  overflow          Int             @default(0)
  /// the cycle didn't cover the whole site (sitemap list cut or capped, link-following hit its page cap, links past
  /// TARGETS_MAX): its findings are reported, but it clears no link task (metrics.links.complete false)
  coverageCut       Boolean         @default(false)
  finishedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  brand Brand          @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  urls  SiteCrawlUrl[]

  @@index([brandId, status, finishedAt])
}

/// A URL of a SiteCrawl: a page read for its links, or a link target checked. ≤ ~4,000 rows a cycle.
model SiteCrawlUrl {
  id         String           @id @default(cuid())
  crawlId    String
  /// ≤ 2,000 chars (URL-encoded, so ASCII: inside the btree limit)
  url        String
  kind       SiteCrawlUrlKind
  /// null = not checked yet
  checkedAt  DateTime?
  status     Int?
  redirects  Int              @default(0)
  /// ok | broken | server-error | chain | loop | skipped | unknown; "recheck" = 5xx waiting for its second try
  outcome    String?
  /// pages of this cycle linking here, and up to 5 of them (for the finding's "on N pages, e.g. …")
  carryCount Int              @default(0)
  /// clicks from the home page (link-following only; 0 for sitemap pages)
  depth      Int              @default(0)
  sources    String[]

  crawl SiteCrawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@unique([crawlId, url])
  @@index([crawlId, checkedAt, kind, carryCount])
}

enum SeoAlertKind {
  CLICKS_DOWN
  POSITION_DOWN
  SITE_DOWN
}

/// One episode of a page (or the whole site) losing search traffic (server/seo/declines.ts, job seo.declines after each
/// complete daily Search Console sync). Days are Google's (Pacific); firstDay/lastDay are the recent window's last day
/// when the rule held. ~a few rows per brand per month.
model SeoAlert {
  id          String       @id @default(cuid())
  workspaceId String
  brandId     String
  kind        SeoAlertKind
  siteUrl     String
  /// the page as Google reports it; "" for SITE_DOWN
  page        String
  /// urlKey(page); "" for SITE_DOWN
  pageKey     String
  /// the evaluation run that raised it (`seo-declines:<sourceId>:<day>`): the bell's grouped notice counts by it
  runKey      String
  firstDay    DateTime     @db.Date
  lastDay     DateTime     @db.Date
  values      Json
  subjectKey  String
  dedupeKey   String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  brand         Brand          @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  notifications Notification[]

  @@index([brandId, subjectKey, lastDay])
  @@index([brandId, lastDay])
  @@index([brandId, createdAt])
  @@index([brandId, pageKey])
  @@index([brandId, runKey])
}

/// GOOGLE is added in its own migration (20261126120000): Postgres can't use a value added by ALTER TYPE … ADD VALUE
/// in the same transaction. Only budgets use GOOGLE for now; the Meta Ads sync writes META only.
enum AdPlatform {
  META
  GOOGLE
}

/// A brand's monthly ad budget per platform (server/data/budgets.ts), in the currency chosen when it was entered.
/// Pacing compares it with AdDay spend converted through FxRate. Amount 0 deletes the row.
model AdBudget {
  id              String     @id @default(cuid())
  workspaceId     String
  brandId         String
  platform        AdPlatform
  /// first day of the month
  month           DateTime   @db.Date
  amount          Decimal    @db.Decimal(14, 2)
  /// in ECB_CURRENCIES or EUR
  currency        String
  updatedByUserId String
  updatedAt       DateTime   @updatedAt

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([brandId, platform, month])
}

/// One ad campaign's numbers for one day of its ad account (the account's own zone), filled by the META_ADS data sync
/// (server/data/meta-ads-sync.ts). Money is in the account's currency on the same row; never summed across currencies.
/// A synced range is replaced in full (delete by brand, platform, account and day range, then insert), so a campaign
/// Meta stops reporting for a day is gone from it.
model AdDay {
  id            String     @id @default(cuid())
  workspaceId   String
  brandId       String
  platform      AdPlatform
  /// "act_123"
  accountId     String
  campaignId    String
  campaignName  String
  /// the ad account's day
  day           DateTime   @db.Date
  currency      String
  spend         Decimal    @db.Decimal(14, 2)
  impressions   Int
  clicks        Int
  purchases     Int
  purchaseValue Decimal    @db.Decimal(14, 2)

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([brandId, platform, accountId, campaignId, day])
  @@index([brandId, platform, accountId, day])
}

enum AdAlertKind {
  SPEND_UP
  ROAS_DOWN
  NO_PURCHASES
  OVER_PACE
}

/// A Meta Ads problem found after an account's daily sync (server/ads/alerts.ts). One row per episode: a rule holding
/// on consecutive days moves lastDay instead of adding rows. values: the figures as strings (Decimal), in `currency`.
/// ponytail: never pruned; a few rows per brand per month. Prune past 13 months if it ever matters.
model AdAlert {
  id           String      @id @default(cuid())
  workspaceId  String
  brandId      String
  kind         AdAlertKind
  /// "act_123"; null for OVER_PACE (brand-wide)
  accountId    String?
  campaignId   String?
  campaignName String?
  currency     String
  /// The rule's own day: D_spend (SPEND_UP), D_conv (ROAS_DOWN, NO_PURCHASES), pacing.through (OVER_PACE)
  firstDay     DateTime    @db.Date
  lastDay      DateTime    @db.Date
  values       Json
  /// <kind>:<brandId>:<account>[:<campaign>] or OVER_PACE:<brandId>:<YYYY-MM>: the episode's subject, always brand-scoped
  subjectKey   String
  /// subjectKey + ":" + firstDay (OVER_PACE: subjectKey, once a month); globally unique because subjectKey holds the brand
  dedupeKey    String      @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  brand         Brand          @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  notifications Notification[]

  @@index([brandId, subjectKey, lastDay])
  @@index([brandId, lastDay])
  @@index([brandId, createdAt])
}

/// ECB euro reference rates: 1 EUR = perEur units of currency on that day (TARGET working days only). Global, not per
/// brand. Filled by the daily fx.sync job (server/data/fx.ts); EUR itself is never stored (its rate is 1).
/// ponytail: ~250 rows per currency per year; a few thousand rows in all.
model FxRate {
  currency String
  day      DateTime @db.Date
  perEur   Decimal  @db.Decimal(18, 6)

  @@id([currency, day])
}

enum ShopifyWriteEntity {
  QUOTE
  BLOG_ARTICLE
}

enum ShopifyWriteAction {
  DRAFT_ORDER_CREATE
  DRAFT_ORDER_UPDATE
  DRAFT_ORDER_INVOICE_SEND
  ARTICLE_CREATE
  ARTICLE_UPDATE
  ARTICLE_PUBLISH
}

/// PENDING: being sent. DONE: Shopify has it. FAILED: Shopify refused it (nothing written; the row is reused on the
/// next confirm). UNKNOWN: no answer, so it may have been written; reconciled before anything is sent again.
enum ShopifyWriteStatus {
  PENDING
  DONE
  FAILED
  UNKNOWN
}

/// One confirmed write to Shopify (server/shopify/writes.ts): at most one per entity version, action and attempt.
model ShopifyWrite {
  id          String             @id @default(cuid())
  workspaceId String
  brandId     String
  entityType  ShopifyWriteEntity
  entityId    String
  /// the entity version that was confirmed
  version     Int
  action      ShopifyWriteAction
  /// a deliberate re-send (invoice, or "Send again" after an unconfirmed attempt) takes the next attempt
  attempt     Int                @default(1)
  payloadHash String
  status      ShopifyWriteStatus @default(PENDING)
  /// times this row was sent (a FAILED row is sent again); the request id is "<id>.<runs>"
  runs        Int                @default(1)
  /// when the latest send started: PENDING goes stale and UNKNOWN may be sent again from here
  startedAt   DateTime           @default(now())
  shopifyId   String?
  actorUserId String
  /// fixed text per reason, never Shopify's or the customer's words
  error       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([entityType, entityId, version, action, attempt])
  @@index([status, startedAt])
}

enum BlogArticleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  HIDDEN_IN_SHOPIFY
  PUBLISHED
  ARCHIVED
}

/// A blog article written in our app (server/blog/articles.ts) and sent to the brand's Shopify blog hidden, then published.
model BlogArticle {
  id            String            @id @default(cuid())
  workspaceId   String
  brandId       String
  /// <= 200
  title         String
  /// slug, unique per brand; how a create whose answer was lost is found in Shopify
  handle        String
  /// <= 500
  summary       String?
  /// ArticleBlock[] (shared/blog.ts), <= 30,000 characters of text
  blocks        Json
  tags          String[]
  /// re-read with brand scope
  productIds    String[]
  taskId        String?
  status        BlogArticleStatus @default(DRAFT)
  /// the confirm token binds it; bumped by edits (a person's or the writer's) only
  version       Int               @default(1)
  shopifyBlogId String?
  shopifyId     String?
  publishedAt   DateTime?
  approvedById  String?
  createdById   String?
  /// who changed the text last (creator, editor, or whoever ran the writer): approving your own needs nobody else to approve
  editedById    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  task  Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([brandId, handle])
  @@index([brandId, status, updatedAt])
}

enum QuoteStatus {
  DRAFT
  CREATED
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
  /// a person recorded the customer's no (CREATED, SENT or EXPIRED → DECLINED); Shopify's draft is left as it is
  DECLINED
}

/// A quote drafted in our app (server/quotes/quotes.ts) and created in Shopify as a draft order (server/quotes/shopify-draft-orders.ts).
model Quote {
  id               String      @id @default(cuid())
  workspaceId      String
  brandId          String
  /// per brand, shown "Q-0042", from BrandProfile.nextQuoteNumber
  number           Int
  status           QuoteStatus @default(DRAFT)
  /// the confirm token binds it; bumped by edits only
  version          Int         @default(1)
  /// PII, a snapshot (not linked to a customer record)
  contactName      String?
  /// PII: sent to Shopify only on invoice send; never in audit metadata or logs
  contactEmail     String?
  /// the customer record (plan 2026-11-27-crm); contactName/contactEmail stay the snapshot the quote was written to
  customerId       String?
  /// the conversation it came from (plan 2026-11-27-crm)
  conversationId   String?
  /// the pipeline deal it belongs to: its sends and acceptance move the deal forward (server/crm/deals.ts)
  dealId           String?
  /// the shop's currency
  currency         String
  /// QuoteLine[] snapshot (shared/quotes.ts): title, variant and unit price frozen when added; <= 100
  lines            Json
  /// QuoteDiscount { kind, value } or null
  discount         Json?
  /// <= 2,000, shown to the customer
  note             String?
  /// <= 2,000, never sent
  internalNote     String?
  /// the invoice send day + 30 (brand day); null until sent, so a draft never expires
  validUntil       DateTime?   @db.Date
  shopifyId        String?
  shopifyName      String?
  /// the version Shopify's draft order holds; invoice send needs it to equal `version`
  syncedVersion    Int?
  /// as Shopify computed it after create/update (before shipping and tax)
  shopifySubtotal  String?
  /// the Shopify subtotal a person accepted when it differs from ours; invoice send needs it to match shopifySubtotal
  subtotalAccepted String?
  invoiceUrl       String?
  orderId          String?
  /// <= 500, why the customer said no (DECLINED); PII-adjacent: never in audit metadata, blanked on erasure
  declinedReason   String?
  sentAt           DateTime?
  /// who sent the invoice last: owns the payment reminders
  sentById         String?
  createdById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  brand        Brand          @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  versions     QuoteVersion[]
  deal         Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  conversation Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customer     Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([brandId, number])
  @@index([brandId, status, updatedAt])
  @@index([customerId])
  @@index([conversationId])
  @@index([dealId])
}

/// A quote as it was before an edit or a revise (plan 2026-11-27-crm, Decision 10). No contact name or email: they stay
/// on Quote only, so erasure has nothing to chase here except the customer note and free line titles.
model QuoteVersion {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String
  quoteId     String
  /// the quote's version this was
  version     Int
  /// QuoteLine[] as they were
  lines       Json
  discount    Json?
  /// the note for the customer, as it was
  note        String?
  /// QuoteTotals as the server worked them out then
  totals      Json
  /// this version had been sent to the customer (snapshotted by a revise)
  sent        Boolean  @default(false)
  /// who replaced it (plain id, as on Quote)
  createdById String?
  createdAt   DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([quoteId, version])
}

// ---- CRM records (plan 2026-11-27-crm, Phase A) -----------------------------------------------------------------
// Customer data: names, identity values, note text never go into logs, job payloads, audit metadata or errors.
// User ids (ownerId, authorId, ...) are plain strings, as on Quote: a removed member's id stays and reads "Former member".

/// A business customer (trade buyer, interior designer's studio). Optional parent of customers. Erasable (server/crm/erase.ts).
model Company {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String
  /// <= 200
  name        String
  /// http(s) only
  website     String?
  /// a member holding crm.manage
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand     Brand      @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  customers Customer[]
  deals     Deal[]

  @@index([brandId, name])
  @@index([updatedAt])
}

enum CustomerSource {
  MANUAL
  QUOTE
  SHOPIFY
  INBOX
}

/// A person B&C deals with. Retention: deleted 24 months after the last activity (server/crm/retention.ts, Decision 18).
model Customer {
  id             String         @id @default(cuid())
  workspaceId    String
  brandId        String
  companyId      String?
  /// PII, <= 200
  displayName    String
  /// "Interior designer", free text <= 100
  role           String?
  /// BCP 47, for AI drafts
  language       String?
  source         CustomerSource @default(MANUAL)
  /// a member holding crm.manage
  ownerId        String?
  /// <= 200
  nextAction     String?
  /// brand-local day
  nextActionDue  DateTime?      @db.Date
  /// bumped by writes to the customer, its notes, conversations, deals and quotes: the retention candidate hint only
  lastActivityAt DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  brand         Brand              @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  company       Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  identities    CustomerIdentity[]
  notes         CustomerNote[]
  quotes        Quote[]
  conversations Conversation[]
  deals         Deal[]

  @@index([brandId, lastActivityAt(sort: Desc), id])
  @@index([brandId, ownerId])
  @@index([companyId])
  @@index([lastActivityAt])
}

enum IdentityKind {
  EMAIL
  PHONE
  INSTAGRAM
  MESSENGER
  SHOPIFY
}

/// How a customer is reached or recognised. A value belongs to one customer per brand and kind (normalised: server/crm/identity.ts).
model CustomerIdentity {
  id          String       @id @default(cuid())
  workspaceId String
  brandId     String
  customerId  String
  kind        IdentityKind
  /// PII, <= 254, normalised
  value       String
  createdAt   DateTime     @default(now())

  brand    Brand    @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([brandId, kind, value])
  @@index([customerId])
}

/// The team's note on a customer: append-only (the author may delete theirs within 24 h).
model CustomerNote {
  id          String   @id @default(cuid())
  workspaceId String
  brandId     String
  customerId  String
  authorId    String?
  /// <= 4,000
  text        String
  createdAt   DateTime @default(now())

  brand    Brand    @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

enum ConversationChannel {
  LOGGED
  INSTAGRAM
  MESSENGER
}

enum MessageMedium {
  EMAIL
  PHONE
  IN_PERSON
  WHATSAPP
  OTHER
}

/// One thread with a customer on any channel (plan 2026-11-27-crm, Decision 1). LOGGED: typed in by a person, always
/// with a customer. A thread from an outside system (Meta in Phase B, Gmail in Phase D) is keyed by
/// (connectionId, externalThreadId). The follow-up state is derived from these columns (server/crm/conversations.ts).
model Conversation {
  id                 String              @id @default(cuid())
  workspaceId        String
  brandId            String
  channel            ConversationChannel
  /// INSTAGRAM/MESSENGER (and Gmail later) only
  connectionId       String?
  /// Meta: the customer's PSID/IGSID; Gmail: the threadId
  externalThreadId   String?
  /// the sender's id on that channel (PSID/IGSID, or a lower-cased email address)
  customerExternalId String?
  customerId         String?
  /// <= 200
  subject            String?
  /// a member holding inbox.read
  ownerId            String?
  /// <= 200
  nextAction         String?
  nextActionDue      DateTime?           @db.Date
  /// the latest message's sentAt, and whether the customer sent it
  lastMessageAt      DateTime
  lastFromCustomer   Boolean
  /// we wrote last (our message's sentAt) or a person marked it waiting on the customer
  waitingSince       DateTime?
  /// the follow-up episode: the first customer message after ours (its sentAt); the follow-up task's key
  episodeAt          DateTime?
  /// the open follow-up task (Task.id, plain), closed on a reply or close
  followUpTaskId     String?
  closedAt           DateTime?
  /// AI, <= 600 (server/crm/summary.ts)
  summary            String?
  summaryThrough     DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  brand    Brand                 @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  customer Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages ConversationMessage[]
  quotes   Quote[]
  deals    Deal[]

  @@unique([connectionId, externalThreadId])
  @@index([brandId, closedAt, lastMessageAt(sort: Desc), id])
  @@index([brandId, ownerId])
  @@index([brandId, nextActionDue])
  @@index([customerId, lastMessageAt])
  @@index([closedAt, waitingSince])
}

/// One message in a Conversation. LOGGED: typed in by a person (medium, loggedById); nothing is ever sent from here.
/// Kept 13 months from sentAt (server/crm/retention.ts).
model ConversationMessage {
  id             String         @id @default(cuid())
  workspaceId    String
  brandId        String
  conversationId String
  /// Meta mid / Gmail message id; null for LOGGED
  externalId     String?
  medium         MessageMedium?
  fromCustomer   Boolean
  /// PII, <= 4,000
  text           String
  /// types only
  attachments    String[]       @default([])
  loggedById     String?
  /// a channel's unsend (Phase B): text cleared, row kept so a late copy can't revive it
  deletedAt      DateTime?
  sentAt         DateTime
  createdAt      DateTime       @default(now())

  brand        Brand        @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId, sentAt])
  @@index([sentAt])
}

/// O2 (owner, 2026-11-27): New → Contacted → Proposal → Negotiation → Won / Lost.
enum DealStage {
  NEW
  CONTACTED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

/// An enquiry or sales opportunity on the pipeline (plan 2026-11-27-crm, Task A7). Quotes move it forward only
/// (server/crm/deals.ts advanceDealForQuote). Not "Opportunity": that name is content ideas.
model Deal {
  id             String    @id @default(cuid())
  workspaceId    String
  brandId        String
  stage          DealStage @default(NEW)
  /// <= 200; the form warns against personal data; replaced on erasure
  title          String
  customerId     String?
  companyId      String?
  conversationId String?
  value          Decimal?  @db.Decimal(14, 2)
  /// ISO 4217, required with value; totals never mix currencies
  currency       String?
  /// a member holding crm.manage
  ownerId        String?
  nextAction     String?
  nextActionDue  DateTime? @db.Date
  /// DealCloseReason (shared/crm.ts) when WON or LOST
  closedReason   String?
  /// <= 500
  closedNote     String?
  stageChangedAt DateTime  @default(now())
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  brand        Brand         @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  quotes       Quote[]

  @@index([brandId, stage, updatedAt])
  @@index([brandId, ownerId])
  @@index([customerId, updatedAt])
  @@index([companyId])
  @@index([conversationId])
  @@index([updatedAt])
}
