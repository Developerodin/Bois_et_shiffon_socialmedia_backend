{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3101",
    "build": "next build",
    "start": "next start -p 3101",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "sync:shared": "node scripts/sync-shared.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "dev:test-user": "tsx --conditions=react-server --env-file=.env scripts/dev-test-user.ts",
    "smoke:neon": "tsx --conditions=react-server --env-file=.env scripts/smoke-neon.ts",
    "smoke:agents": "tsx --conditions=react-server --env-file=.env scripts/smoke-agents.ts",
    "smoke:research": "tsx --conditions=react-server --env-file=.env scripts/smoke-research.ts",
    "check:brand-assets": "tsx --conditions=react-server --env-file=.env scripts/check-brand-assets.ts",
    "check:models": "tsx --conditions=react-server --env-file=.env scripts/check-models.ts",
    "check:platform-admin": "tsx --conditions=react-server --env-file=.env scripts/check-platform-admin.ts",
    "platform-admin": "tsx --conditions=react-server --env-file=.env scripts/platform-admin.ts",
    "set-password": "tsx --conditions=react-server --env-file=.env scripts/set-password.ts",
    "usage": "tsx --conditions=react-server --env-file=.env scripts/usage-report.ts",
    "redact:story-checks": "tsx --conditions=react-server --env-file=.env scripts/redact-story-checks.ts",
    "eval": "tsx --conditions=react-server --env-file=.env scripts/evals/run.ts",
    "smoke:auth": "tsx --conditions=react-server --env-file=.env scripts/smoke-auth.ts",
    "smoke:rbac": "tsx --conditions=react-server --env-file=.env scripts/smoke-rbac.ts",
    "smoke:connections": "tsx --conditions=react-server --env-file=.env scripts/smoke-connections.ts",
    "smoke:google": "tsx --conditions=react-server --env-file=.env scripts/smoke-google-signup.ts",
    "smoke:chat": "tsx --conditions=react-server --env-file=.env scripts/smoke-chat.ts",
    "smoke:pipeline": "tsx --conditions=react-server --env-file=.env scripts/smoke-pipeline.ts",
    "smoke:competitors": "tsx --conditions=react-server --env-file=.env scripts/smoke-competitors.ts",
    "smoke:credits": "tsx --conditions=react-server --env-file=.env scripts/smoke-credits.ts",
    "audit": "tsx --conditions=react-server --env-file=.env scripts/run-audit.ts",
    "probe:meta": "tsx --conditions=react-server --env-file=.env scripts/probe-meta-data.ts",
    "worker:dev": "tsx --conditions=react-server --env-file=.env worker/main.ts",
    "build:worker": "esbuild worker/main.ts --bundle --platform=node --target=node22 --outfile=dist/worker.js --external:@prisma/client --external:ffmpeg-static --external:ffprobe-static --external:sharp --conditions=react-server --alias:@=.",
    "postinstall": "prisma generate",
    "smoke:publishing": "tsx --conditions=react-server --env-file=.env scripts/smoke-publishing.ts",
    "set-plan": "tsx --conditions=react-server --env-file=.env scripts/set-plan.ts",
    "seed:story": "tsx --conditions=react-server --env-file=.env scripts/seed-story.ts"
  },
  "prisma": {
    "seed": "tsx --conditions=react-server prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.99",
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@prisma/client": "^6.19.2",
    "ai": "^7.0.148",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "jose": "^6.2.13",
    "next": "15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "prisma": "^6.19.2",
    "react": "~19.1.2",
    "react-dom": "~19.1.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "prisma@6.19.3": true
  }
}
