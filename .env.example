# =============================================================================
# Multi-Brand AI CMO Platform — environment template (no secrets committed)
# Server (apps/server): copy to apps/server/.env (see docs/ENV_SETUP.md). The Web Frontend has its own apps/web/.env.example (SERVER_URL only).
# Values are unquoted, with comments on their own lines: `docker run --env-file` reads every character after `=`
# literally (quotes and inline comments included), while dotenv reads these lines the same way.
# =============================================================================

# --- Database (apps/server/prisma) ---
# Neon (Postgres + Object Storage). Pulled by `npx neon@latest deploy` / `env pull` into repo-root .env.local; copy into apps/server/.env
# DATABASE_URL: pooled (-pooler host) — app traffic
DATABASE_URL=
# DATABASE_URL_UNPOOLED: direct — Prisma Migrate (schema directUrl)
DATABASE_URL_UNPOOLED=
# STORAGE_ACCESS_KEY_ID: S3-compatible object storage (Neon locally; private bucket)
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=media

# --- Auth.js v5 (DEC-001) — required for login ---
# Generate: openssl rand -base64 32  (or PowerShell in ENV_SETUP.md)
AUTH_SECRET=
AUTH_URL=http://localhost:3100
# Extra website origins allowed to make cookie writes (comma list), e.g. a LAN address in dev. AUTH_URL's origin is always allowed.
WEB_ORIGINS=
# "log" only logs cross-origin cookie writes (first deploy); anything else refuses them with 403.
CSRF_MODE=
# Comma list of clients (web, mobile) whose paid starts answer 503 for now, e.g. PAID_STARTS_OFF_FOR=web.
PAID_STARTS_OFF_FOR=
AUTH_TRUST_HOST=true

# --- Seed (Phase 1 — optional overrides) ---
SEED_BRANDS_PATH=
SEED_OWNER_PASSWORD=changeme-dev-only

# --- Background jobs (DEC-006) ---
CRON_SECRET=

# --- Credential encryption (DEC-002, DEC-018) ---
CREDENTIALS_ENCRYPTION_KEY=
CREDENTIALS_KEY_VERSION=1

# --- AI providers (Screen 6+) ---
OPENAI_API_KEY=
# "on" lets the Planner plan LinkedIn and X posts (posted by hand). Leave off until the phone build that names
# LinkedIn and X is released; posts made by hand on them work either way.
PLANNER_HAND_CHANNELS=

# --- Meta (Instagram / Facebook) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3100/api/v1/integrations/meta/callback
# Meta Ads uses the same app id/secret with its own login (ads_read only). Add this URI to the app's valid redirect URIs.
META_ADS_REDIRECT_URI=http://localhost:3100/api/v1/integrations/meta_ads/callback

# --- Reddit (platform API; Devvit app is separate) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3100/api/v1/integrations/reddit/callback

# --- Pinterest ---
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3100/api/v1/integrations/pinterest/callback

# --- Google (GSC / GA4) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PageSpeed Insights (site health scores); anonymous quota is shared and often exhausted
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_REDIRECT_URI=http://localhost:3100/api/v1/integrations/google/callback

# --- Threads (separate app ID/secret in the Meta app's Threads use case) ---
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3100/api/v1/integrations/threads/callback

# --- Instagram API with Instagram Login (optional alternative to Page-linked Instagram) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3100/api/v1/integrations/instagram/callback

# Email (SMTP) for invites + password reset. Port 465 = TLS, 587 = STARTTLS; timeout in seconds
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT=7
EMAIL_FROM=

# --- AskCart (Shopify reads for the one brand whose store AskCart holds; server/shopify/askcart.ts) ---
# AskCart's base address, without /api/partner (e.g. https://askcart.example). Unset: "Connect via AskCart" is hidden.
ASKCART_URL=
# AskCart's PARTNER_API_SECRET, sent as a Bearer header. Env only: never stored, logged or put in a job payload.
ASKCART_SECRET=

# --- Server process (EC2) ---
# Set false on the API when the standalone worker (node dist/worker.js) runs the queue; unset runs jobs in the API too.
RUN_JOBS_IN_API=
WORKER_INTERVAL_MS=15000
# How many jobs the worker runs at once (independent claim loops), so a long agent run doesn't hold up emails.
WORKER_CONCURRENCY=4
# Whether the worker queues the paid daily sweep (scheduled agent runs, plan renewals, catalog syncs): true/1 or
# false/0. Unset: on only when NODE_ENV=production, so worker:dev is off and production is on. The docker images set
# NODE_ENV=production: uncomment this for a local docker worker, so it never runs the sweep against a shared database.
# Leave it commented out (or true) in production.
# WORKER_DAILY_SWEEP=false

# --- Provider secrets the code reads (listed so the web bundle check covers them) ---
# ElevenLabs: voices, the voice library and voice cloning.
ELEVENLABS_API_KEY=
# Google Places search for a brand's address.
GOOGLE_MAPS_API_KEY=
# Higgsfield's key secret (paired with its key id): clips, presenters, photoshoots.
HIGGSFIELD_API_KEY_SECRET=
# Twilio: phone sign-in codes.
TWILIO_AUTH_TOKEN=
# Expo push notifications (optional; raises the push rate limit).
EXPO_ACCESS_TOKEN=
# Encrypts stored provider credentials; a numbered key so it can be rotated.
CREDENTIALS_ENCRYPTION_KEY_1=

# Dev only: a test login for browser checks (npm run dev:test-user). Leave the password empty to generate one.
DEV_TEST_EMAIL=
DEV_TEST_PASSWORD=
